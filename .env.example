# Modèle de configuration locale. Copier vers `.env` et remplir.
# `.env` est ignoré par git — ne JAMAIS mettre de valeur réelle dans ce fichier-ci,
# qui est versionné dans un dépôt public.

VITE_CRM_WEBHOOK_URL=https://hook.eu1.make.com/votre_code_ici
VITE_META_PIXEL_ID=votre_pixel_id_ici

VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_CLIENT_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=votre_cle_publique_emailjs

# Clé Anthropic — DÉVELOPPEMENT LOCAL UNIQUEMENT.
# Tout var préfixée VITE_ présente au moment du build est inscrite EN CLAIR dans le
# bundle JS public. Cette clé n'est lue que dans une branche gardée par
# `import.meta.env.DEV` (voir services/claudeService.ts), donc elle est éliminée des
# builds de production. Ne l'ajoutez jamais au step "Build" de .github/workflows/deploy.yml.
# En production, la clé vit uniquement dans le secret GitHub CLAUDE_API_KEY, injecté
# côté serveur dans public/api/claude.php.
VITE_CLAUDE_API_KEY=sk-ant-api03-xxxxxxxx

# Identifiants de déploiement (FTP OVH) : ne sont PAS lus depuis ce fichier.
# Ils doivent rester exclusivement dans les secrets GitHub du dépôt :
#   FTP_SERVER, FTP_USERNAME, FTP_PASSWORD, CLAUDE_API_KEY
